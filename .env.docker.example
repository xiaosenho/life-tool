# ============================================
# LifeTool Docker Compose 环境变量模板
# 复制为 .env.docker 并填入真实值
# ============================================

# Server
SERVER_PORT=8091
SPRING_PROFILES_ACTIVE=postgres

# PostgreSQL (容器内通信，服务名=postgres)
POSTGRES_USER=pgvector
POSTGRES_PASSWORD=change-me
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/lifetool
SPRING_DATASOURCE_USERNAME=pgvector
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=16
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=4
SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=300000
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=10000
SPRING_DATASOURCE_HIKARI_MAX_LIFETIME=1800000

# Redis
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# Flyway (空库首次初始化设为 true)
LIFETOOL_DB_MIGRATION_ENABLED=true

# JWT (openssl rand -base64 32)
JWT_SECRET=change-me
JWT_ACCESS_TTL_MS=86400000
JWT_REFRESH_TTL_MS=604800000

# ============================================
# 腾讯云 COS 对象存储配置
# ============================================
COS_REGION=ap-guangzhou
COS_BUCKET=change-me
COS_SECRET_ID=change-me
COS_SECRET_KEY=change-me
COS_PUBLIC_BASE_URL=https://change-me.cos.ap-guangzhou.myqcloud.com
COS_UPLOAD_TOKEN_TTL_SECONDS=300
MEDIA_MAX_IMAGE_BYTES=10485760

# ============================================
# AI / Spring AI 配置
# ============================================
LIFETOOL_AI_MOCK_ENABLED=false
LIFETOOL_AI_MAX_TOOL_ROUNDS=3

AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_CHAT_COMPLETIONS_PATH=/chat/completions
AI_API_KEY=change-me
AI_CHAT_MODEL=doubao-seed-2-0-mini-260428

# ============================================
# 阿里云移动推送配置（好友离线消息推送）
# ============================================
LIFETOOL_PUSH_ALIYUN_ENABLED=false
LIFETOOL_PUSH_ALIYUN_ACCESS_KEY_ID=change-me
LIFETOOL_PUSH_ALIYUN_ACCESS_KEY_SECRET=change-me
LIFETOOL_PUSH_ALIYUN_APP_KEY=
LIFETOOL_PUSH_ALIYUN_ANDROID_ACTIVITY=com.anonymous.lifetool.MainActivity
LIFETOOL_PUSH_ALIYUN_ANDROID_OPEN_TYPE=ACTIVITY
LIFETOOL_PUSH_ALIYUN_STORE_OFFLINE=true
LIFETOOL_PUSH_REMINDERS_SCAN_DELAY_MS=3600000

# Android APK/调试包构建时注入
LIFETOOL_ALIYUN_PUSH_APP_KEY=
LIFETOOL_ALIYUN_PUSH_APP_SECRET=
