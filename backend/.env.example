# ============================================
# LifeTool Backend Environment Configuration
# ============================================
# 使用方式：
#   cp backend/.env.example backend/.env
#   然后根据需要修改变量
#
# 阿里云 ECS 生产部署：
#   1. 安装 Docker & Docker Compose
#   2. 在服务器上创建 .env 文件，填入生产密码
#   3. docker compose up -d
#   4. 使用 Nginx/Caddy 反代后端到 443 端口
#   5. 确保数据库 5432 和 Redis 6379 端口未对公网开放
# 详细说明见 docs/DEPLOYMENT.md

# Server
SERVER_PORT=8080

# PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lifetool
SPRING_DATASOURCE_USERNAME=lifetool
# 生产环境务必修改密码！
# 如果后端直接运行在 ECS 宿主机上，请与仓库根目录 .env 的 POSTGRES_PASSWORD 保持一致。
SPRING_DATASOURCE_PASSWORD=lifetool_dev

# Redis
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# JWT
# 生产环境务必生成一个足够长的随机密钥！
# 可通过 openssl rand -base64 32 生成
JWT_SECRET=change-me-to-a-random-256-bit-key-in-production
JWT_ACCESS_TTL_MS=900000
JWT_REFRESH_TTL_MS=604800000

# ============================================
# 腾讯云 COS 对象存储配置
# ============================================
# COS 地域，如 ap-guangzhou（广州）、ap-shanghai（上海）等
COS_REGION=ap-guangzhou
# COS Bucket 名称，生产建议填写完整 bucket，例如 lifetool-media-prod-1234567890
COS_BUCKET=your-bucket-name-1234567890
# 腾讯云访问密钥（子账号最小权限，仅允许上传指定路径和读取）
# 生产环境密钥不得提交到 Git，通过 ECS .env 文件注入
COS_SECRET_ID=your-secret-id
COS_SECRET_KEY=your-secret-key
# 客户端上传完成后可通过该 CDN/源站域名生成访问地址。
# 私有 bucket 不应直接公网读，后续可改为后端签发短有效期下载 URL。
COS_PUBLIC_BASE_URL=https://your-cdn-domain.com
# 后端签发的上传授权临时令牌有效期（秒），默认 300 秒（5 分钟）
COS_UPLOAD_TOKEN_TTL_SECONDS=300
# 单张图片最大字节数，默认 10485760（10MB）
MEDIA_MAX_IMAGE_BYTES=10485760
